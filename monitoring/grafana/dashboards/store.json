{
  "uid": "store-overview",
  "title": "Store — tráfego, erros e latência",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "Requisições/s por serviço", "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"spring\"}[1m]))", "legendFormat": "{{instance}}"}]
    },
    {
      "id": 2, "title": "Respostas 5xx/s", "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"spring\",status=~\"5..\"}[1m]))", "legendFormat": "{{instance}}"}]
    },
    {
      "id": 3, "title": "Latência p95 (s)", "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, instance) (rate(http_server_requests_seconds_bucket{job=\"spring\"}[1m])))", "legendFormat": "{{instance}}"}]
    },
    {
      "id": 4, "title": "Uso de CPU do processo", "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "process_cpu_usage{job=\"spring\"}", "legendFormat": "{{instance}}"}]
    }
  ]
}
